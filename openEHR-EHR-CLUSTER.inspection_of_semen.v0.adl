definition
	CLUSTER[at0000] matches {    -- Inspection of semen
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Fluid name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Colour
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0003,    -- Cream/gray-opalescent
							at0004,    -- Yellowish
							at0005,    -- Red-brown
							at0006]    -- Clear and colourless
						}
					}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Viscocity
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0008,    -- Normal
							at0009]    -- Abnormal
						}
					}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Odour
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0011,    -- Normal
							at0012,    -- Odour of urine
							at0013]    -- Odour of putreaction
						}
					}
				}
			}
			ELEMENT[at0020] occurrences matches {0..1} matches {    -- Liquefaction
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0021,    -- Complete
							at0022]    -- Incomplete
						}
					}
				}
			}
			allow_archetype CLUSTER[at0018] occurrences matches {0..*} matches {    -- pH
				include
					archetype_id/value matches {/.*/}
			}
		}
	}

