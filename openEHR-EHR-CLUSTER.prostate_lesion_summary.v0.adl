definition
	CLUSTER[at0000] occurrences matches {0..*} matches {    -- Prostate lesion summary
		items cardinality matches {1..*; unordered} matches {
			CLUSTER[at0001] occurrences matches {0..*} matches {*}    -- Lesion details
			ELEMENT[at0003] occurrences matches {0..*} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

