definition
	CLUSTER[at0000] matches {    -- Follow up
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Follow up
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- Yes
							at0003,    -- No
							at0004]    -- Not specified
						}
					}
				}
			}
		}
	}

