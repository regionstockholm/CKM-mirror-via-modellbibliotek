definition
	CLUSTER[at0000] occurrences matches {0..1} matches {    -- Prostate diagnostic procedures
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- MRI examination date
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- MRI examination comment
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Prostate fusion biopsy date
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
		}
	}

