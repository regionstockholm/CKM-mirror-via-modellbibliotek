definition
	CLUSTER[at0000] matches {    -- Pain rating_scale
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Numerical rating scale 0-10
				value matches {
					DV_COUNT matches {*}
					DV_INTERVAL<DV_COUNT> matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Start time
				value matches {
					DV_TIME matches {*}
				}
			}
		}
	}

