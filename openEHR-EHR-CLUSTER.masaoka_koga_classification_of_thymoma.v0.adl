definition
	CLUSTER[at0000] matches {    -- Masaoka koga classification of thymoma
		items cardinality matches {0..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Stage
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- I
							at0003,    -- IIA
							at0004,    -- IIB
							at0005,    -- III
							at0006,    -- IVA
							at0007]    -- IVB
						}
					}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	terminologies_available = <"SNOMED-CT", ...>
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Masaoka koga classification of thymoma">
					description = <"Used to record the Masaoka-Koga staging classification of thymoma. The classification assesses the extent of local invasion and metastatic spread and categorises thymomas into stages I, IIA, IIB, III, IVA and IVB.">
					comment = <"Goizueta-San Martín G, Girón-Arango L, et al. Clin Transl Oncol. 2022;24:1418–1432.">
				>
				["at0001"] = <
					text = <"Stage">
					description = <"">
				>
				["at0002"] = <
					text = <"I">
					description = <"Grossly and microscopically completely encapsulated tumour, including invasion into but not through the capsule. In the absence of a capsule, there is no invasion into surrounding tissues.">
				>
				["at0003"] = <
					text = <"IIA">
					description = <"Microscopic transcapsular invasion of less than 3 mm.">
				>
				["at0004"] = <
					text = <"IIB">
					description = <"Gross extension into normal thymus or perithymic fat surrounding the tumour, microscopically confirmed; or macroscopic adherence to the pleura or pericardium without invasion.">
				>
				["at0005"] = <
					text = <"III">
					description = <"Microscopic invasion of the mediastinal pleura, visceral pleura or pericardium; direct invasion into the lung parenchyma; invasion into the phrenic or vagus nerves; invasion into or penetration through major vascular structures; or adherence of the lung or adjacent organs when associated with microscopically confirmed mediastinal pleural or pericardial invasion.">
				>
				["at0006"] = <
					text = <"IVA">
					description = <"Microscopically confirmed separate nodules on the visceral or parietal pleural, pericardial or epicardial surfaces.">
				>
				["at0007"] = <
					text = <"IVB">
					description = <"Lymphogenous or haematogenous metastasis.">
				>
				["at0008"] = <
					text = <"Comment">
					description = <"">
				>
			>
		>
		["sv"] = <
			items = <
