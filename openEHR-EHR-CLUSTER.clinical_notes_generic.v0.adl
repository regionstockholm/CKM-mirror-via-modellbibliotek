definition
	CLUSTER[at0000] matches {    -- Clinical notes_generic
		items cardinality matches {1..*; unordered} matches {
			allow_archetype CLUSTER[at0001] occurrences matches {0..*} matches {    -- Notes text
				include
					archetype_id/value matches {/.*|openEHR-EHR-CLUSTER\.generic_keyword_obx\.v1/}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Striked
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Notes
				value matches {
					DV_EHR_URI matches {*}
				}
			}
		}
	}

