definition
	CLUSTER[at0000] occurrences matches {0..1} matches {    -- Systematic prostate biopsy summary
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Number of biopsy cores
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0009] occurrences matches {0..1} matches {    -- Number of positive biopsy cores
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Maximum cancer lentgh
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::122]>
						list = <
							["1"] = <
								units = <"mm">
							>
						>
					>
				}
			}
			ELEMENT[at0011] occurrences matches {0..1} matches {    -- Total cancer length
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::122]>
						list = <
							["1"] = <
								units = <"mm">
							>
						>
					>
				}
			}
			ELEMENT[at0012] occurrences matches {0..1} matches {    -- Total biopsy length
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::122]>
						list = <
							["1"] = <
								units = <"mm">
							>
						>
					>
				}
			}
			ELEMENT[at0013] occurrences matches {0..1} matches {    -- Percentage of Gleason pattern 4 or higher
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::380]>
						list = <
							["1"] = <
								units = <"%">
							>
						>
					>
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Additional comments
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

