definition
	EVALUATION[at0000.1] matches {    -- Recommendation
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- Topic
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0002] occurrences matches {1..*} matches {    -- Recommendation
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..*} matches {    -- Rationale
						value matches {
							DV_TEXT matches {*}
						}
					}
					CLUSTER[at0.1] occurrences matches {0..1} matches {    -- Robot-assisted laparoscopic prostatectomy (RALP)
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0.2] occurrences matches {0..1} matches {    -- Recommendation
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
							ELEMENT[at0.28] occurrences matches {0..1} matches {    -- Comment
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					CLUSTER[at0.3] occurrences matches {0..1} matches {    -- Lymph node dissection
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0.5] occurrences matches {0..1} matches {    -- Recommendation
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
							ELEMENT[at0.29] occurrences matches {0..1} matches {    -- Comment
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					CLUSTER[at0.6] occurrences matches {0..1} matches {    -- Bladderneck sparing
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0.7] occurrences matches {0..1} matches {    -- Recommendation
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
							ELEMENT[at0.30] occurrences matches {0..1} matches {    -- Comment
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					CLUSTER[at0.8] occurrences matches {0..1} matches {    -- Apical dissection
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0.9] occurrences matches {0..1} matches {    -- Recommendation
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0.10,    -- Maximal preservation of urethra
											at0.11,    -- At the level of apex
											at0.12]    -- With margin from urethra
										}
									}
								}
							}
							ELEMENT[at0.31] occurrences matches {0..1} matches {    -- Comment
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					CLUSTER[at0.13] occurrences matches {0..1} matches {    -- Nerve sparing
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0.14] occurrences matches {0..6} matches {    -- Nerve sparing right
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0.15,    -- Intra high
											at0.16,    -- Intra low
											at0.17,    -- Inter high
											at0.18,    -- Inter low
											at0.19,    -- Semi
											at0.20]    -- Non-nerve sparing
										}
									}
								}
							}
							ELEMENT[at0.32] occurrences matches {0..1} matches {    -- Comment right
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0.21] occurrences matches {0..6} matches {    -- Nerve sparing left
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0.22,    -- Intra high
											at0.23,    -- Intra low
											at0.24,    -- Inter high
											at0.25,    -- Inter low
											at0.26,    -- Semi
											at0.27]    -- Non-nerve sparing
										}
									}
								}
							}
							ELEMENT[at0.33] occurrences matches {0..1} matches {    -- Comment left
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- Last updated
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

