definition
	CLUSTER[at0000] matches {    -- Involuntary childlessness
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- No of years
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Interventions
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0004,    -- IVF
							at0005,    -- Ovulation stimulation
							at0006,    -- ICSI
							at0007,    -- Surgery
							at0008,    -- None
							at0009]    -- Other
						}
					}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Free text
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

