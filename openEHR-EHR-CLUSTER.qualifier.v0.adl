definition
	CLUSTER[at0000] matches {    -- Qualifier
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Status
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- Active
							at0003]    -- Inactive
						}
					}
				}
			}
		}
	}

