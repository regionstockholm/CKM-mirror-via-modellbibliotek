archetype (adl_version=1.4; uid=162cccb5-4a73-4d08-9e11-cb9f6b1540e5)
	openEHR-EHR-CLUSTER.ejaculatory_abstinence.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
			>
