definition
	CLUSTER[at0000] matches {    -- Cancelled text
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Cancelled
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Reason for cancellation
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

