definition
	CLUSTER[at0000] matches {    -- WHO histopathological classification of thymoma
		items cardinality matches {0..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Histopathological type
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- Type A
							at0003,    -- Type AB
							at0004,    -- Type B1
							at0005,    -- Type B2
							at0006]    -- Type B3
						}
					}
				}
			}
		}
	}

ontology
	terminologies_available = <"SNOMED-CT", ...>
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"WHO histopathological classification of thymoma">
					description = <"Used to record the histopathological classification of thymoma according to the WHO Classification of Tumours, 5th edition.">
					comment = <"WHO Classification of Tumours Editorial Board. Thoracic Tumours. 5th ed. Lyon (FR): International Agency for Research on Cancer; 2021.">
				>
				["at0001"] = <
					text = <"Histopathological type">
					description = <"">
					comment = <"Marx A, Chan JKC, Coindre JM, Detterbeck F, Girard N, Harris NL, et al. The 2015 WHO Classification of Tumors of the Thymus: Continuity and Changes. J Thorac Oncol. 2015;10(10):1383-1395.">
				>
				["at0002"] = <
					text = <"Type A">
					description = <"Spindle-shaped epithelial cells with few or no immature T lymphocytes.">
				>
				["at0003"] = <
					text = <"Type AB">
					description = <"Mixture of type A thymoma and lymphocyte-rich areas.">
				>
				["at0004"] = <
					text = <"Type B1">
					description = <"Thymus-like architecture with abundant immature T lymphocytes and few epithelial cells.">
				>
				["at0005"] = <
					text = <"Type B2">
					description = <"Increased numbers of polygonal epithelial cells intermingled with abundant immature T lymphocytes.">
				>
				["at0006"] = <
					text = <"Type B3">
					description = <"Epithelial-rich tumour with few or absent immature T lymphocytes.">
				>
			>
		>
		["sv"] = <
			items = <
				["at0000"] = <
					text = <"Histopatologiska klassifikation av tymom enligt WHO">
					description = <"Används för att dokumentera den histopatologiska klassifikationen av tymom enligt WHO:s tumörklassifikation, 5:e upplagan.">
					comment = <"WHO Classification of Tumours Editorial Board. Thoracic Tumours. 5th ed. Lyon (FR): International Agency for Research on Cancer; 2021.">
				>
				["at0001"] = <
					text = <"Histopatologisk typ">
					description = <"">
					comment = <"Marx A, Chan JKC, Coindre JM, Detterbeck F, Girard N, Harris NL, et al. The 2015 WHO Classification of Tumors of the Thymus: Continuity and Changes. J Thorac Oncol. 2015;10(10):1383-1395.">
				>
				["at0002"] = <
					text = <"Type A">
					description = <"Spolformade epitelceller med få eller inga omogna T-lymfocyter.">
				>
				["at0003"] = <
					text = <"Type AB">
					description = <"Blandning av typ A-tymom och lymfocytrika områden.">
				>
				["at0004"] = <
					text = <"Type B1">
					description = <"Tymusliknande vävnadsstruktur med ett stort antal omogna T-lymfocyter och få epitelceller.">
				>
				["at0005"] = <
					text = <"Type B2">
					description = <"Ökat antal polygonala epitelceller blandade med ett stort antal omogna T-lymfocyter.">
				>
				["at0006"] = <
					text = <"Type B3">
					description = <"Epitelcellsrik tumör med få eller inga omogna T-lymfocyter.">
				>
			>
		>
	>
