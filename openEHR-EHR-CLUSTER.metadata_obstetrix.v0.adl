definition
	CLUSTER[at0000] matches {    -- Metadata_obstetrix
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0012] occurrences matches {0..1} matches {    -- Document ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Parent document
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0013] occurrences matches {0..1} matches {    -- Care record ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0014] occurrences matches {0..1} matches {    -- Care record _child ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Care record_type
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Care record_name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0015] occurrences matches {0..1} matches {    -- Care encounter ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Care enounter_type
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Care enounter_type_Name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0011] occurrences matches {0..1} matches {    -- Ward name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0016] occurrences matches {0..1} matches {    -- Ward ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0017] occurrences matches {0..1} matches {    -- Signature
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0018] occurrences matches {0..1} matches {    -- Signing time
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0020] occurrences matches {0..1} matches {    -- Signed by user ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0021] occurrences matches {0..1} matches {    -- Countersigned by User ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0022] occurrences matches {0..1} matches {    -- Contrasigned
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0023] occurrences matches {0..1} matches {    -- Countersigned date
				value matches {
					DV_DATE matches {*}
				}
			}
		}
	}

