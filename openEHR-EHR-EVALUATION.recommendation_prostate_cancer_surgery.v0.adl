definition
	EVALUATION[at0000] matches {    -- Recommendation
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0004] occurrences matches {0..1} matches {    -- Robot-assisted laparoscopic prostatectomy (RALP)
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0005] occurrences matches {0..1} matches {    -- Recommendation
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
							ELEMENT[at0007] occurrences matches {0..1} matches {    -- Comment
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					CLUSTER[at0006] occurrences matches {0..1} matches {    -- Lymph node dissection
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0008] occurrences matches {0..1} matches {    -- Recommendation
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
							ELEMENT[at0009] occurrences matches {0..1} matches {    -- Comment
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					CLUSTER[at0010] occurrences matches {0..1} matches {    -- Bladderneck sparing
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0011] occurrences matches {0..1} matches {    -- Recommendation
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
							ELEMENT[at0012] occurrences matches {0..1} matches {    -- Comment
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					CLUSTER[at0014] occurrences matches {0..1} matches {    -- Apical dissection
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0015] occurrences matches {0..1} matches {    -- Recommendation
								value matches {
									DV_CODED_TEXT matches {*}
								}
							}
							ELEMENT[at0017] occurrences matches {0..1} matches {    -- Comment
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					CLUSTER[at0018] occurrences matches {0..1} matches {    -- Nerve sparing
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0021] occurrences matches {0..1} matches {    -- Nerve sparing left
								value matches {
									DV_CODED_TEXT matches {*}
								}
							}
							ELEMENT[at0022] occurrences matches {0..1} matches {    -- Comment left
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0019] occurrences matches {0..1} matches {    -- Nerve sparing right
								value matches {
									DV_CODED_TEXT matches {*}
								}
							}
							ELEMENT[at0020] occurrences matches {0..1} matches {    -- Comment right
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					ELEMENT[at0024] occurrences matches {0..1} matches {    -- Conference recommendation
						value matches {
							DV_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0023] occurrences matches {0..*} matches {    -- Additional surgical recommendation
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0002] matches {*}    -- Item tree
		}
	}

