definition
	CLUSTER[at0000] matches {    -- Pain impact
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..*} matches {    -- Pain impact scale
				value matches {
					DV_COUNT matches {
						magnitude matches {|0..10|}
					}
					DV_INTERVAL<DV_COUNT> matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Pain imact description
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

