definition
	CLUSTER[at0000] matches {    -- Attestation
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Activity
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- Signed
							at0003]    -- Not signed
						}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Signed DateTime
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
		}
	}

