definition
	CLUSTER[at0000] matches {    -- Metadata_notes
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Notes_ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- User_ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- User_name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- CreatedOnUnit_ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0011] occurrences matches {0..1} matches {    -- CreatedOnUnit
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- CreatedByProfessionalRole_ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0009] occurrences matches {0..1} matches {    -- CreatedByProfessionalRole
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Logged in_ID
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0012] occurrences matches {0..1} matches {    -- IsSpecialistPhysician
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0013] occurrences matches {0..1} matches {    -- RowCancelled
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- Notes_change
				include
					archetype_id/value matches {/.*/}
			}
		}
	}

