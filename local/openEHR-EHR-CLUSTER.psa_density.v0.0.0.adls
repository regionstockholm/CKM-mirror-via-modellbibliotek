definition
    CLUSTER[id1] matches {    -- PSA density
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[id2] occurrences matches {0..1} matches {    -- PSA density
                value matches {
                    DV_QUANTITY[id9001] matches {
                        property matches {[at9000]}    -- Concentration
                        units matches {"ng/mL/cm3"}
                    }
                }
            }
        }
    }

